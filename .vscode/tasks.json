{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Construire l'installateur Windows",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"installer\\build-installer.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Compiler Windows Release",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"windows",
				"--release",
				"--no-pub"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}